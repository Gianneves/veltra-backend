# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Database (TypeORM)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_user
DB_PASSWORD=your_password
DB_DATABASE=veltra_fitness
DB_SYNCHRONIZE=1
DB_AUTOLOADENTITIES=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Strava OAuth
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:3001/api/v1/auth/strava/callback

# Strava webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=seu_token_de_verificacao
STRAVA_WEBHOOK_CALLBACK_URL=https://seu-dominio/api/v1/strava/webhook

# OpenAI
OPENAI_API_KEY=your_openai_api_key
# auto = roteia por tarefa/complexidade; cheap/premium = força um tier
OPENAI_MODEL_ROUTING=auto
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o
# tenta o modelo premium quando o cheap falha no parsing (true/false)
OPENAI_MODEL_ESCALATION=true
